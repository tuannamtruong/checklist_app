<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No <uses-permission> at all — deliberately.

      There is no INTERNET permission, so this app *cannot* reach the network
      even if it wanted to. It is not a sync client: it reads and writes files
      in a folder you grant it, and whatever app syncs that folder does the
      rest. Storage access comes from the folder grant itself (SAF), which
      needs no manifest permission and no All Files Access.
    -->

    <!--
      X-17. Android 11 hides installed packages from an app that has not said
      which ones it cares about, and getLaunchIntentForPackage returns null for
      the rest. This is the same catalog src/core/providers.ts holds, and it is
      only ever used to *start* one of them: there is no INTERNET permission
      here, so nothing is ever said to it.
    -->
    <queries>
        <package android:name="mega.privacy.android.app" />
        <package android:name="com.dropbox.android" />
        <package android:name="com.google.android.apps.docs" />
        <package android:name="com.microsoft.skydrive" />
        <package android:name="com.nextcloud.client" />
        <package android:name="com.nutomic.syncthingandroid" />
        <!-- X-15: whatever this phone opens a folder with. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.document/directory" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
